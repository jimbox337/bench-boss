# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Database URL (required for authentication)
# For local development with SQLite:
# DATABASE_URL=file:./dev.db

# For production with Vercel Postgres:
# Get these from Vercel dashboard after creating Postgres database
# POSTGRES_URL is the Accelerate proxy URL (for app queries)
# POSTGRES_URL_NON_POOLING is the direct connection (for Prisma Studio/migrations)
POSTGRES_URL=your-postgres-accelerate-connection-string
POSTGRES_URL_NON_POOLING=your-postgres-direct-connection-string

# Groq API Configuration (required for AI player analysis - FREE!)
# Get your FREE API key from: https://console.groq.com/
GROQ_API_KEY=your-groq-api-key-here

# Email Configuration (optional - for admin/test emails)
# Using Resend (recommended): https://resend.com/
RESEND_API_KEY=your-resend-api-key-here
EMAIL_FROM=Bench Boss <noreply@yourdomain.com>

# Configure social sign-in and authentication email delivery in Supabase.
