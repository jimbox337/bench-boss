{
  "manifest_version": 3,
  "name": "Bench Boss ESPN Sync",
  "version": "1.0.1",
  "description": "Securely connect your logged-in ESPN Fantasy Hockey leagues to Bench Boss.",
  "permissions": ["cookies", "storage", "tabs"],
  "host_permissions": [
    "https://*.espn.com/*",
    "https://www.benchboss.pro/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Bench Boss ESPN Sync",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.espn.com/fantasy/hockey/*", "https://fantasy.espn.com/hockey/*"],
      "js": ["espn-content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.benchboss.pro/*"],
      "js": ["benchboss-bridge.js"],
      "run_at": "document_start"
    }
  ]
}
